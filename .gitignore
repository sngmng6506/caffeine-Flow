node_modules/
.env
# Claude Code 설정 — 팀이 공유하는 세션 시작 훅만 커밋하고
# 개인 설정(settings.local.json)과 세션 부산물은 계속 무시한다.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json

# 빌드 산출물 — 배포 때마다 재생성된다.
# customer 빌드가 outDir: '../server/public' + emptyOutDir: true 라
# server/public 전체를 통째로 덮어쓰므로 커밋할 이유가 없다.
# (server/admin-ui 는 이 삭제를 피하려고 public 밖에 둔 것 — 무시하면 안 됨)
server/public/
owner/dist/

# Python 분석 워커 로컬 환경·바이트코드
__pycache__/
*.py[cod]
.venv/

# 로컬 임시 스크립트
server/test-api.js
server/test-db.js
