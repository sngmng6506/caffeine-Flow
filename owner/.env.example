# ── 서버 URL ──────────────────────────────────────────
# 개발 시 비워두면 Vite 프록시 사용 (자동)
# 패키징된 Electron 앱(프로덕션)에서는 반드시 설정
# VITE_SERVER_URL=http://서버IP:3000

# ── Google OAuth (클라이언트) ─────────────────────────
# 서버의 GOOGLE_CLIENT_ID와 동일한 값
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── 네이버 로그인 활성화 (선택) ───────────────────────
# 네이버 OAuth 설정 완료 후 true로 변경
VITE_NAVER_ENABLED=false
