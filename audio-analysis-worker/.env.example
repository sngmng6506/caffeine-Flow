# 미니PC 상주 워커 설정 예시. 실제 파일은 저장소 밖(~/caffeine-audio/worker.env)에 두고
# chmod 600으로 보호한다. 시크릿을 저장소에 커밋하지 않는다.

# 결과를 제출할 Caffeine Flow 서버. 운영은 Railway 주소다.
CAFFEINE_FLOW_SERVER_URL=https://example.up.railway.app

# 서버의 AUDIO_ANALYSIS_WORKER_TOKEN과 같은 값. 이 토큰만으로 결과 제출이 가능하므로
# 로그·커밋·이슈에 남기지 않는다.
AUDIO_ANALYSIS_WORKER_TOKEN=

# 수동 CLI의 Valence/Arousal 추정 스위치. 자동 MAEST_ONLY 큐에서는 사용하지 않는다.
# 사용하는 사전학습 모델이 비상업(CC BY-NC-SA 4.0) 라이선스라, 평가 목적으로
# 명시적으로 켤 때만 동작한다. `true` 외의 값은 모두 꺼짐으로 본다.
ENABLE_VALENCE_AROUSAL=false

# 작업 디렉터리 루트. 자동 워커는 여기에 락 파일만 두고, 수동 CLI(worker.py)가
# inbox/processing/processed/failed를 쓴다.
AUDIO_WORKER_ROOT=/home/사용자명/caffeine-audio

# 모델 파일(.pb)을 둔 디렉터리. 저장소에 커밋하지 않는다.
AUDIO_MODEL_DIR=/home/사용자명/caffeine-audio/models

# 서버 작업 큐가 비었을 때 다시 확인하기까지의 간격(ms).
POLL_INTERVAL_MS=5000

# 실패 알림용 Discord webhook. 비워 두면 알리지 않는다.
DISCORD_AUDIO_WEBHOOK_URL=

# 자동 워커(remote_worker.py)는 true면 **기동을 거절한다**. 서버 큐를 소비하면서
# 결과를 안 보내면 작업이 조용히 사라지기 때문이다. 서버 없이 확인하려면 이 값을
# false로 두고 CLI의 --dry-run 또는 test_track.py를 쓴다.
AUDIO_WORKER_DRY_RUN=false
