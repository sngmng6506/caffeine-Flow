# systemd 유닛(user 서비스). 등록 절차는 README.md "미니PC 상주 워커"에 있다.
# 비밀은 이 파일에 두지 않는다 — EnvironmentFile이 gitignore된 .env를 읽는다.
[Unit]
Description=Caffeine Flow 음향 분석 워커
Documentation=https://github.com/sngmng6506/caffeine-Flow/blob/main/audio-analysis-worker/README.md
# 결과 제출은 outbound HTTPS다. 네트워크가 올라온 뒤에 뜬다.
After=network-online.target
Wants=network-online.target
# 설정 오류로 즉시 죽는 상황에서 무한 재시작하지 않도록 한도를 둔다.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# 설치하는 기계에 맞게 고친다. %h는 서비스를 등록한 사용자의 홈이다.
WorkingDirectory=%h/caffeine-Flow/audio-analysis-worker
EnvironmentFile=%h/caffeine-audio/worker.env
ExecStart=%h/caffeine-audio/venv/bin/python remote_worker.py

# 큐가 비어 있어도 계속 돌며 폴링한다. 조용히 멈춰 있는 것이 가장 나쁜 실패다.
Restart=always
RestartSec=10
TimeoutStopSec=1000

# 같은 미니PC에서 CafeStudy ADB 워커가 함께 돈다. 분석은 급하지 않은 배치이므로
# 양보하게 두어, ADB 자동화가 정해진 시각에 밀리지 않도록 한다.
Nice=10
IOSchedulingClass=idle
# 실측(N95 4코어, 3분 음원 + Valence/Arousal): CPU 222%, 최대 RSS 1.56GB, 12.3초.
# 코어 넷 중 둘만 쓰게 잘라 ADB 워커와 데스크톱에 여유를 남긴다.
CPUQuota=200%
# 실측 최대치의 두 배. 더 긴 음원은 오디오 배열이 길이에 비례해 커진다.
MemoryMax=3G

# 이 워커는 로컬 파일을 읽고 밖으로 HTTPS만 보낸다. 안으로 여는 포트는 없다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# 큐 디렉터리와 락 파일만 쓸 수 있으면 된다.
ReadWritePaths=%h/caffeine-audio
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true

# 로그는 journal로 간다: journalctl --user -u caffeine-audio-worker -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=caffeine-audio-worker

[Install]
WantedBy=default.target
