# ── 서버 공통 ────────────────────────────────────────
PORT=3000

# Supabase → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# 랜덤 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-here

# ── Google OAuth ──────────────────────────────────────
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID
# 승인된 JavaScript 출처에 http://localhost:5174 추가
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Naver OAuth ───────────────────────────────────────
# https://developers.naver.com → 애플리케이션 등록
# Callback URL: http://localhost:3000/api/v1/auth/naver/callback
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# ── URL 설정 (OAuth 리다이렉트·OpenRouter 앱 식별) ─────
# APP_URL: 사장님 앱 주소 (개발: 5174, 배포 시 실제 도메인)
APP_URL=http://localhost:5174
# SERVER_URL: 서버 주소 (네이버 callback URI 등록 시 이 주소 사용)
SERVER_URL=http://localhost:3000

# ── OpenRouter AI 음악 필터 ───────────────────────────
# 실제 신청 필터와 사장님 테스트 API가 동일한 키·모델 설정을 공유
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Caffeine Flow
MUSIC_FILTER_MODEL=openai/gpt-4.1-mini
MUSIC_FILTER_TIMEOUT_MS=8000

# ── YouTube API (선택) ────────────────────────────────
# 미설정 시 길이/라이브 체크 비활성화
YOUTUBE_API_KEY=your-youtube-api-key-here
